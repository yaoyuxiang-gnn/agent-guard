# Normalise line endings so that a commit made on Windows is byte-identical to
# one made on Linux. Without this, `core.autocrlf=true` (the Git for Windows
# default) hands a Linux CI runner a Makefile full of carriage returns, and
# `make` fails with "missing separator" — a failure that never reproduces on the
# machine that committed it.
#
# `eol=lf` also means a fresh Windows checkout gets LF, which every tool in this
# project handles (CPython, pytest, make via Git Bash or WSL).

* text=auto eol=lf

# Never normalise binary assets.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff  binary
*.woff2 binary
*.pdf  binary

# Windows-only scripts keep their native endings.
*.bat text eol=crlf
*.cmd text eol=crlf

# Keep the generated demo diffable as text rather than treating it as an opaque
# blob; it is regenerated by tools/make_demo_svg.py and reviewers should see the
# change.
docs/demo.svg text eol=lf

# Collapse generated noise in diffs and language stats.
docs/demo.svg linguist-generated=true
